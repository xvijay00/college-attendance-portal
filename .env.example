# ========================================================
# Supabase & Application Environment Configuration
# ========================================================

# Supabase Database URL:
# 1. Go to https://supabase.com -> Open your project
# 2. Click "Project Settings" (gear icon at bottom left)
# 3. Click "Database"
# 4. Under "Connection string", select "URI"
# 5. Copy and paste it below, replacing [YOUR-PASSWORD] with your database password:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server Port
PORT=3000

# JWT Authentication Secret
JWT_SECRET=college_attendance_secure_jwt_token_2026
